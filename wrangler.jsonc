{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "charity-realtor-site",
  "compatibility_date": "2026-08-07",
  "main": "./worker/index.js",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["charity@curtiscrewict.com", "stevenm621844@yahoo.com"],
      "allowed_sender_addresses": ["website@charitymenefee.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
