---
import BaseLayout from './BaseLayout.astro';
import '../styles/blog.css';
import { CHARITY_NAME, CHARITY_JOB_TITLE, CHARITY_BROKERAGE, DEFAULT_SOCIAL_IMAGE } from '../data/business';
import { resolveAbsoluteURL } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  subtitle: string;
  category: string;
  location: string;
  author: string;
  publishedDate: string;
  displayDate: string;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  subtitle,
  category,
  location,
  author,
  publishedDate,
  displayDate,
  socialImage,
  socialImageAlt,
} = Astro.props;

const hasHeroMedia = Astro.slots.has('hero-media');

const canonicalURL = resolveAbsoluteURL(Astro.site, Astro.url.pathname);
const absoluteSocialImage = resolveAbsoluteURL(Astro.site, socialImage ?? DEFAULT_SOCIAL_IMAGE);

const blogPostingJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: absoluteSocialImage,
  datePublished: publishedDate,
  mainEntityOfPage: canonicalURL,
  author: {
    '@type': 'Person',
    name: CHARITY_NAME,
    jobTitle: CHARITY_JOB_TITLE,
    worksFor: {
      '@type': 'Organization',
      name: CHARITY_BROKERAGE,
    },
  },
});
---

<BaseLayout
  title={`${title} | Charity Menefee`}
  description={description}
  pageClass="page-interior page-blog-post"
  socialTitle={title}
  socialImage={socialImage}
  socialImageAlt={socialImageAlt}
  ogType="article"
  articlePublishedTime={publishedDate}
>
  <script type="application/ld+json" set:html={blogPostingJsonLd} />
  <article class="blog-post">
    <header class="blog-post-hero">
      <div class:list={['shell', 'blog-post-hero-grid', { 'blog-post-hero-grid-text-only': !hasHeroMedia }]}>
        <div class="blog-post-hero-copy" data-reveal="hero-copy">
          <a class="blog-back-link" href="/blog/"><span aria-hidden="true">←</span> Back to the blog</a>
          <p class="eyebrow">{category} · {location}</p>
          <h1>{title}</h1>
          <p class="blog-post-subtitle">{subtitle}</p>
          <p class="blog-post-byline">By {author} <span aria-hidden="true">·</span> <time datetime={publishedDate}>{displayDate}</time></p>
        </div>
        {hasHeroMedia && (
          <div class="blog-post-hero-media" data-reveal="right-scale">
            <slot name="hero-media" />
          </div>
        )}
      </div>
    </header>

    <div class="blog-post-body">
      <slot />
    </div>
  </article>
</BaseLayout>
