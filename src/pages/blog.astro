---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../data/blogPosts';
import purpleSpoonPhoto from '../assets/blog/1-local-guide-valley-center/valley-center-purple-spoon-facebook.jpg';
import '../styles/blog.css';

const [featuredPost] = blogPosts;
---

<BaseLayout
  title="Local Guides and Real Estate Notes | Charity Menefee"
  description="Local places, community happenings, and practical real estate information from Charity Menefee in Valley Center, Wichita, and nearby Kansas communities."
  pageClass="page-interior page-blog-landing"
>
  <section class="blog-landing-hero" aria-labelledby="blog-title">
    <div class="shell blog-landing-hero-inner" data-reveal="hero-copy">
      <p class="eyebrow">From around home</p>
      <h1 id="blog-title">Local places, useful information, and a few things worth knowing.</h1>
      <p>A mix of hometown favorites, community happenings, and practical real estate information from Valley Center, Wichita, and nearby communities.</p>
    </div>
  </section>

  <section class="blog-latest" aria-labelledby="latest-post-title">
    <div class="shell">
      <p class="eyebrow" data-reveal="left">Latest story</p>
      <article class="blog-featured-post">
        <a class="blog-featured-media" href={featuredPost.href} aria-label={`Read ${featuredPost.title}`} data-reveal="left-scale">
          <Picture
            class="blog-featured-photo"
            src={purpleSpoonPhoto}
            formats={['avif', 'webp']}
            widths={[480, 720, 960, 1280, 1536]}
            sizes="(min-width: 48rem) 50vw, 100vw"
            alt="The Purple Spoon sign on Main Street at sunset"
          />
        </a>
        <div class="blog-featured-copy" data-reveal="right">
          <p class="blog-card-meta">{featuredPost.category} · {featuredPost.location}</p>
          <h2 id="latest-post-title"><a href={featuredPost.href}>{featuredPost.title}</a></h2>
          <p>{featuredPost.excerpt}</p>
          <p class="blog-card-date"><time datetime={featuredPost.publishedDate}>{featuredPost.displayDate}</time></p>
          <a class="arrow-link" href={featuredPost.href}>Read the story <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
