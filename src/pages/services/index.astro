---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallToAction from '../../components/CallToAction.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import acreagePhoto from '../../assets/shared/kansas/kansas-land-aerial.png';
---

<BaseLayout
  title="Real Estate Services | Charity Menefee"
  description="Explore Charity Menefee's approachable real estate guidance for buying, selling, and land or acreage in the Wichita area."
>
  <PageHero
    eyebrow="Real estate services"
    title="Guidance built around the decision in front of you."
    intro="Whether you're buying, selling, or considering a place with more room, I’ll keep the process understandable and the conversation low-pressure."
    image={acreagePhoto}
    imageAlt="Aerial view of Kansas fields, tree lines, homes, and country roads"
  />

  <section class="section-space" aria-labelledby="service-path-title">
    <div class="shell">
      <div class="section-heading split-heading">
        <div data-reveal="left"><p class="eyebrow">Choose a starting point</p><h2 id="service-path-title">Different plans need different kinds of support.</h2></div>
        <p data-reveal="right">You don't need to have every detail settled before reaching out. A first conversation can simply help clarify what to consider next.</p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section-space section-sage" aria-labelledby="approach-title">
    <div class="shell editorial-grid">
      <div data-reveal="left"><p class="eyebrow">My approach</p><h2 id="approach-title">Useful context, honest questions, and time to think.</h2></div>
      <div class="prose" data-reveal="right">
        <p>A real estate decision can be important without becoming overwhelming. I start by listening, then help organize the moving pieces into a plan you can understand.</p>
        <p>The goal isn't to create urgency. It's to make sure you have the information and support needed to move forward when the timing makes sense.</p>
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
