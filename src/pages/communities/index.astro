---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallToAction from '../../components/CallToAction.astro';
import PageHero from '../../components/PageHero.astro';
import wichitaPhoto from '../../assets/communities/wichita/Wichita_River.jpg';
import valleyCenterPhoto from '../../assets/communities/valley-center/Valley_Center_Water_Tower.jpg';

const plannedCommunities = [
  { name: 'Andover', slug: 'andover', direction: 'East of Wichita' },
  { name: 'Derby', slug: 'derby', direction: 'South of Wichita' },
  { name: 'Maize', slug: 'maize', direction: 'Northwest of Wichita' },
  { name: 'Park City', slug: 'park-city', direction: 'North of Wichita' },
  { name: 'Goddard', slug: 'goddard', direction: 'West of Wichita' },
  { name: 'Newton', slug: 'newton', direction: 'North of the Wichita area' },
];
---

<BaseLayout
  title="Wichita Area Communities | Charity Menefee"
  description="Begin exploring Wichita, Valley Center, and nearby south-central Kansas communities with local real estate guidance from Charity Menefee."
>
  <PageHero
    eyebrow="Communities"
    title="Find the place that fits the way you want to live."
    intro="Wichita and its neighboring communities each offer a different setting. These guides are a starting point for learning the landscape without reducing a place to a sales pitch."
    image={wichitaPhoto}
    imageAlt="Downtown Wichita and the Arkansas River in warm evening light"
  />

  <section class="section-space" aria-labelledby="featured-communities-title">
    <div class="shell">
      <div class="section-heading split-heading">
        <div data-reveal="left"><p class="eyebrow">First local guides</p><h2 id="featured-communities-title">Begin with Wichita and Valley Center.</h2></div>
        <p data-reveal="right">These first two pages use real local photography and distinct content. Additional guides will be built with the same care as verified information and imagery are gathered.</p>
      </div>
      <div class="featured-community-grid">
        <a class="featured-community" href="/communities/wichita/" data-reveal="left-scale">
          <Picture src={wichitaPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 48rem) 55vw, 100vw" alt="The Arkansas River flowing toward downtown Wichita" />
          <span><small>Explore the guide</small>Wichita <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/valley-center/" data-reveal="right">
          <Picture src={valleyCenterPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 48rem) 45vw, 100vw" alt="The Valley Center water tower beyond a green tree line" />
          <span><small>Explore the guide</small>Valley Center <i aria-hidden="true">→</i></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-space section-surface" aria-labelledby="more-communities-title">
    <div class="shell planned-community-layout">
      <div class="planned-community-intro" data-reveal="left">
        <p class="eyebrow">More nearby places</p>
        <h2 id="more-communities-title">Local guides in planning.</h2>
        <p>These communities are part of the site plan, but their dedicated pages are intentionally not being filled with generic copy. For now, contact Charity to talk about any of these areas.</p>
        <a class="button button-primary" href="/contact/">Ask about an area</a>
      </div>
      <div class="planned-community-list reveal-stagger">
        {plannedCommunities.map((community) => (
          <article id={`community-${community.slug}`} data-reveal="up">
            <span>{community.direction}</span>
            <h3>{community.name}</h3>
            <p>Dedicated local guide in planning.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <aside class="shell fair-housing-note" data-reveal="scale-up">
    <p><strong>A note about choosing a community:</strong> Charity can help you compare practical property and location considerations. Decisions about whether an area is right for you remain personal, and community guidance is provided without steering or demographic assumptions.</p>
  </aside>
  <CallToAction title="Want to compare a few Wichita-area communities?" />
</BaseLayout>
