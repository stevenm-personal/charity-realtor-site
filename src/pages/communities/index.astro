---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallToAction from '../../components/CallToAction.astro';
import PageHero from '../../components/PageHero.astro';
import heroPhoto from '../../assets/communities/wichita/wichita-wind-surge-aerial-kansastourism-NoC.jpg';
import wichitaPhoto from '../../assets/communities/wichita/wichita-keeper-of-the-plains-kansastourism-NoC.jpg';
import valleyCenterPhoto from '../../assets/communities/valley-center/valley-center-water-tower-self-owned.jpg';
import maizePhoto from '../../assets/communities/maize/maize-clair-donnelly-amphitheater-from-left-self-owned.JPG';
import andoverPhoto from '../../assets/communities/andover/city-of-andover-heritage-park-plaza-statue.jpg';
import derbyPhoto from '../../assets/communities/derby/rock-river-rapids-aerial-rock-river-rapids.jpg';
import goddardPhoto from '../../assets/communities/goddard/goddard-tanganyika-wildlife-park-kansastourism-2016 Ryan Donnell.jpg';
import newtonPhoto from '../../assets/communities/newton/newton-amtrak-self-taken.jpg';
import parkCityPhoto from '../../assets/communities/park-city/park-city-city-hall-sign-self-owned-wikipedia-commons.jpg';
---

<BaseLayout
  title="Wichita Area Communities | Charity Menefee"
  description="Begin exploring Wichita, Valley Center, and nearby south-central Kansas communities with local real estate guidance from Charity Menefee."
>
  <PageHero
    eyebrow="Communities"
    title="Find the place that fits the way you want to live."
    intro="Wichita and its neighboring communities each offer a different setting. These guides are a starting point for learning the landscape without reducing a place to a sales pitch."
    image={heroPhoto}
    imageAlt="An aerial view of the Wichita Wind Surge ballpark at sunset, with the city stretching to the horizon"
    imagePosition="center 40%"
    imagePositionMobile="center 42%"
  />

  <section class="section-space" aria-labelledby="featured-communities-title">
    <div class="shell">
      <div class="section-heading split-heading">
        <div data-reveal="left"><p class="eyebrow">Local guides</p><h2 id="featured-communities-title">Explore Wichita and seven nearby communities.</h2></div>
        <p data-reveal="right">Each guide uses local photography and community-specific information to give you a practical starting point for comparing the area.</p>
      </div>
      <div class="featured-community-grid">
        <a class="featured-community featured-community-primary" href="/communities/wichita/" data-reveal="left-scale">
          <Picture src={wichitaPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 67rem) 50vw, (min-width: 48rem) 50vw, 100vw" style="object-position: 84% center;" alt="The Keeper of the Plains sculpture beside the Arkansas River in Wichita" />
          <span><small>Explore the guide</small>Wichita <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community featured-community-primary" href="/communities/valley-center/" data-reveal="right">
          <Picture src={valleyCenterPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024, 1280, 1584]} sizes="(min-width: 48rem) 80rem, 64rem" alt="The Valley Center water tower at golden hour, rising above a tree line with a weathered barn in the foreground" />
          <span><small>Explore the guide</small>Valley Center <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/andover/" data-reveal="right">
          <Picture src={andoverPhoto} formats={['avif', 'webp']} widths={[480, 720, 940]} sizes="(min-width: 67rem) 33vw, (min-width: 48rem) 50vw, 100vw" alt="A bronze statue at Heritage Park Plaza in Andover" />
          <span><small>Explore the guide</small>Andover <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/derby/" data-reveal="right">
          <Picture src={derbyPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw" alt="An aerial view of the water slides and lazy river at Rock River Rapids in Derby" />
          <span><small>Explore the guide</small>Derby <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/goddard/" data-reveal="right">
          <Picture src={goddardPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024, 1280]} sizes="(min-width: 67rem) 33vw, (min-width: 48rem) 50vw, 100vw" alt="A Tanganyika Wildlife Park staff member and a visitor crouching in the grass beside a serval" />
          <p class="photo-credit photo-credit-top photo-credit-scrim">© 2016 Ryan Donnell</p>
          <span><small>Explore the guide</small>Goddard <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/maize/" data-reveal="right">
          <Picture src={maizePhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 67rem) 33vw, (min-width: 48rem) 50vw, 100vw" alt="The Clair Donnelly Amphitheater and its lawn at Maize City Park" />
          <span><small>Explore the guide</small>Maize <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/newton/" data-reveal="right">
          <Picture src={newtonPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024, 1280]} sizes="(min-width: 67rem) 33vw, (min-width: 48rem) 50vw, 100vw" alt="The historic Newton Station depot and its fountain at golden hour" />
          <span><small>Explore the guide</small>Newton <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/park-city/" data-reveal="right">
          <Picture src={parkCityPhoto} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(min-width: 67rem) 33vw, (min-width: 48rem) 50vw, 100vw" style="object-position: 20% center;" alt="The sculptural Park City sign outside city hall" />
          <span><small>Explore the guide</small>Park City <i aria-hidden="true">→</i></span>
        </a>
      </div>
    </div>
  </section>

  <aside class="shell fair-housing-note" data-reveal="scale-up">
    <p><strong>A note about choosing a community:</strong> Practical property and location considerations can be compared without deciding whether an area is right for you. Those decisions remain personal, and community guidance is provided without steering or demographic assumptions.</p>
  </aside>
  <CallToAction
    title="Want to compare a few Wichita-area communities?"
    copy="If you're comparing communities or have questions about a specific property, tell me what you're considering. I’ll help you sort through the location and property details that matter."
  />
</BaseLayout>
