---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallToAction from '../../components/CallToAction.astro';
import PageHero from '../../components/PageHero.astro';
import wichitaPhoto from '../../assets/communities/wichita/Wichita_River.jpg';
import valleyCenterPhoto from '../../assets/communities/valley-center/valley-center-water-tower.jpg';
import maizePhoto from '../../assets/communities/maize/clair-donnelly-amphitheater-city-of-maize.jpg';
import andoverPhoto from '../../assets/communities/andover/andover-central-park-derby-informer.webp';
import derbyPhoto from '../../assets/communities/derby/derby-high-park-facebookhighpark.jpg';
import goddardPhoto from '../../assets/communities/goddard/goddard-lake-afton-observatory-redit.jpg';
import newtonPhoto from '../../assets/communities/newton/newton-ks-hero-facebook.jpg';

const plannedCommunities = [
  { name: 'Park City', slug: 'park-city', direction: 'North of Wichita' },
];
---

<BaseLayout
  title="Wichita Area Communities | Charity Menefee"
  description="Begin exploring Wichita, Valley Center, and nearby south-central Kansas communities with local real estate guidance from Charity Menefee."
>
  <PageHero
    eyebrow="Communities"
    title="Find the place that fits the way you want to live."
    intro="Wichita and its neighboring communities each offer a different setting. These guides are a starting point for learning the landscape without reducing a place to a sales pitch."
    image={wichitaPhoto}
    imageAlt="Downtown Wichita and the Arkansas River in warm evening light"
  />

  <section class="section-space" aria-labelledby="featured-communities-title">
    <div class="shell">
      <div class="section-heading split-heading">
        <div data-reveal="left"><p class="eyebrow">Local guides</p><h2 id="featured-communities-title">Explore Wichita and six nearby communities.</h2></div>
        <p data-reveal="right">Each completed guide uses real local photography and distinct content. Additional pages will be built with the same care as verified information and imagery are gathered.</p>
      </div>
      <div class="featured-community-grid">
        <a class="featured-community" href="/communities/wichita/" data-reveal="left-scale">
          <Picture src={wichitaPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 48rem) 55vw, 100vw" alt="The Arkansas River flowing toward downtown Wichita" />
          <span><small>Explore the guide</small>Wichita <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/valley-center/" data-reveal="right">
          <Picture src={valleyCenterPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 48rem) 45vw, 100vw" alt="The Valley Center water tower beyond a green tree line" />
          <span><small>Explore the guide</small>Valley Center <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/maize/" data-reveal="right">
          <Picture src={maizePhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 48rem) 45vw, 100vw" alt="Clair Donnelly Amphitheater and the Maize water tower during an evening event" />
          <span><small>Explore the guide</small>Maize <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/andover/" data-reveal="right">
          <Picture src={andoverPhoto} formats={['avif', 'webp']} widths={[480, 720, 940]} sizes="(min-width: 48rem) 50vw, 100vw" alt="An outdoor community event beside Lake George in Andover Central Park" />
          <span><small>Explore the guide</small>Andover <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/derby/" data-reveal="right">
          <Picture src={derbyPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024]} sizes="(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw" alt="Playground and recreation space at High Park in Derby" />
          <span><small>Explore the guide</small>Derby <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community" href="/communities/goddard/" data-reveal="right">
          <Picture src={goddardPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024, 1280]} sizes="(min-width: 67rem) 33vw, (min-width: 48rem) 50vw, 100vw" alt="Lake Afton Observatory beneath a star-filled Kansas sky near Goddard" />
          <span><small>Explore the guide</small>Goddard <i aria-hidden="true">→</i></span>
        </a>
        <a class="featured-community featured-community-newton" href="/communities/newton/" data-reveal="right">
          <Picture src={newtonPhoto} formats={['avif', 'webp']} widths={[480, 720, 1024, 1280]} sizes="(min-width: 67rem) 66vw, (min-width: 48rem) 100vw, 100vw" alt="Newton Station and fountain surrounded by flowers in Newton, Kansas" />
          <span><small>Explore the guide</small>Newton <i aria-hidden="true">→</i></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-space section-surface" aria-labelledby="more-communities-title">
    <div class="shell planned-community-layout">
      <div class="planned-community-intro" data-reveal="left">
        <p class="eyebrow">More nearby places</p>
        <h2 id="more-communities-title">Local guides in planning.</h2>
        <p>These communities are part of the site plan, but their dedicated pages are intentionally not being filled with generic copy. For now, their local guides remain in planning.</p>
        <a class="button button-primary" href="/contact/">Ask about an area</a>
      </div>
      <div class="planned-community-list reveal-stagger">
        {plannedCommunities.map((community) => (
          <article id={`community-${community.slug}`} data-reveal="up">
            <span>{community.direction}</span>
            <h3>{community.name}</h3>
            <p>Dedicated local guide in planning.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <aside class="shell fair-housing-note" data-reveal="scale-up">
    <p><strong>A note about choosing a community:</strong> Practical property and location considerations can be compared without deciding whether an area is right for you. Those decisions remain personal, and community guidance is provided without steering or demographic assumptions.</p>
  </aside>
  <CallToAction title="Want to compare a few Wichita-area communities?" />
</BaseLayout>
