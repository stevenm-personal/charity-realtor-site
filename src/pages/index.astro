---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { blogPosts } from '../data/blogPosts';
import charityPhoto from '../assets/charity/charity-headshot-sitting-cropped.jpg';
import andoverPhoto from '../assets/communities/andover/andover-captiol-federal-ampitheater-LK-Architecture.jpg';
import derbyPhoto from '../assets/communities/derby/derby-canoes-travelks.jpg';
import wichitaPhoto from '../assets/communities/wichita/Wichita_Downtown.jpg';
import valleyCenterPhoto from '../assets/communities/valley-center/valley-center-water-tower.jpg';

const recentPosts = blogPosts.slice(0, 2);
---

<BaseLayout
  title="Charity Menefee | REALTOR®"
  description="Patient, personal real estate guidance for buyers, sellers, and people exploring land in Wichita and nearby south-central Kansas communities."
  pageClass="page-home"
>
  <Hero />

  <section class="meet-section section-space" aria-labelledby="meet-title">
    <div class="shell meet-grid">
      <div class="meet-image-wrap" data-reveal="left-scale">
        <Picture
          class="meet-image"
          src={charityPhoto}
          formats={['avif', 'webp']}
          widths={[288, 336, 384, 480, 576, 672, 736]}
          sizes="(min-width: 48rem) 24rem, (min-width: 23rem) 21rem, calc(100vw - 2rem)"
          quality={90}
          alt="Charity Menefee seated in a warm home interior"
        />
        <p class="image-caption">Charity Menefee · Wichita-area real estate agent</p>
      </div>
      <div class="meet-copy" data-reveal="layer-right">
        <p class="eyebrow">Meet Charity</p>
        <h2 id="meet-title">Kansas roots. Straightforward guidance.</h2>
        <p>
          I was born and raised in small-town Kansas, and I bring that steady, down-to-earth approach
          to real estate. No pressure, no pushy sales stuff, just clear guidance, honest answers, and
          a calm hand through the whole process.
        </p>
        <p>
          Whether you’re buying your first home, selling to start a new chapter, or relocating and
          trying to get your bearings, I’ll help you make smart decisions without feeling rushed. I’ll
          explain what’s happening, what’s coming next, and what actually matters so you can feel
          confident instead of overwhelmed.
        </p>
        <a class="arrow-link" href="/about/">More about Charity <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="services-home section-space" aria-labelledby="services-title">
    <div class="shell">
      <div class="section-heading split-heading">
        <div data-reveal="left">
          <p class="eyebrow">Ways to work together</p>
          <h2 id="services-title">Practical help for the move in front of you.</h2>
        </div>
        <div data-reveal="right">
          <p>One-on-one guidance shaped around your questions, timing, and priorities.</p>
          <a class="arrow-link" href="/services/">View all services <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="communities-home section-space" aria-labelledby="communities-title">
    <div class="shell">
      <div class="section-heading communities-heading">
        <div data-reveal="left">
          <p class="eyebrow">Close to home</p>
          <h2 id="communities-title">Places with their own pace and personality.</h2>
        </div>
        <div data-reveal="right">
          <p>Explore a starting point for learning about Wichita and nearby communities.</p>
          <a class="arrow-link" href="/communities/">Explore all communities <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="community-collage">
        <a class="community-tile community-tile-wichita" href="/communities/wichita/" data-reveal="left-scale">
          <Picture
            src={wichitaPhoto}
            formats={['avif', 'webp']}
            widths={[480, 720, 1024]}
            sizes="(min-width: 48rem) 60vw, 100vw"
            alt="Downtown Wichita beside the Arkansas River in warm evening light"
          />
          <span class="community-tile-copy">
            <small>City living · established neighborhoods</small>
            <span class="community-tile-city">Wichita</span>
            <span class="community-tile-action">Explore the guide <span aria-hidden="true">→</span></span>
          </span>
        </a>
        <a class="community-tile community-tile-valley" href="/communities/valley-center/" data-reveal="right">
          <Picture
            src={valleyCenterPhoto}
            formats={['avif', 'webp']}
            widths={[480, 720, 960, 1280, 1584]}
            sizes="(min-width: 67rem) 96rem, 48rem"
            style="object-position: 52% center;"
            alt="The Valley Center water tower above a tree-lined landscape"
          />
          <span class="community-tile-copy">
            <small>Close to Wichita. Clearly Valley Center.</small>
            <span class="community-tile-city">Valley Center</span>
            <span class="community-tile-action">Explore the guide <span aria-hidden="true">→</span></span>
          </span>
        </a>
        <a class="community-tile community-tile-andover" href="/communities/andover/" data-reveal="up">
          <Picture
            src={andoverPhoto}
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(min-width: 67rem) 22vw, (min-width: 48rem) 50vw, 100vw"
            style="object-position: 58% center;"
            alt="Capitol Federal Amphitheater in Andover Central Park"
          />
          <span class="community-tile-copy">
            <span class="community-tile-city">Andover</span>
            <span class="community-tile-action">Explore the guide <span aria-hidden="true">→</span></span>
          </span>
        </a>
        <a class="community-tile community-tile-derby" href="/communities/derby/" data-reveal="up">
          <Picture
            src={derbyPhoto}
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(min-width: 67rem) 22vw, (min-width: 48rem) 50vw, 100vw"
            style="object-position: 58% center;"
            alt="Kayakers entering the Arkansas River at Warren Riverview Park in Derby"
          />
          <span class="community-tile-copy">
            <span class="community-tile-city">Derby</span>
            <span class="community-tile-action">Explore the guide <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="journal-preview section-space" aria-labelledby="journal-title">
    <div class="shell journal-preview-grid">
      <div class="journal-intro" data-reveal="left">
        <p class="eyebrow">From the journal</p>
        <h2 id="journal-title">Local stories and useful guidance.</h2>
        <p>I share local places, community happenings, and practical real estate information to give you a better feel for the area and what's happening around it.</p>
        <a class="arrow-link" href="/blog/">Visit the blog <span aria-hidden="true">→</span></a>
      </div>

      <div class="journal-cards reveal-stagger" aria-label="Recent journal stories">
        {recentPosts.map((post) => (
          <article class="journal-card" data-reveal="up">
            <a class="journal-card-media" href={post.href} aria-label={`Read ${post.title}`}>
              <Picture
                class="journal-card-photo"
                src={post.thumbnail}
                formats={['avif', 'webp']}
                widths={[320, 480, 640]}
                sizes="(min-width: 67rem) 220px, (min-width: 48rem) 30vw, 100vw"
                alt={post.thumbnailAlt}
              />
              {post.thumbnailCredit && <span class="journal-card-credit">{post.thumbnailCredit}</span>}
            </a>
            <div class="journal-card-copy">
              <p class="journal-card-meta">{post.category} · {post.location}</p>
              <h3><a href={post.href}>{post.title}</a></h3>
              <p class="journal-card-excerpt">{post.excerpt}</p>
              <a class="arrow-link" href={post.href}>Read the story <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
