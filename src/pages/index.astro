---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import charityPhoto from '../assets/charity/charity-headshot-1.jpg';
import wichitaPhoto from '../assets/communities/wichita/Wichita_Downtown.jpg';
import valleyCenterPhoto from '../assets/communities/valley-center/Valley_Center_Welcome_Sign.jpg';
import prairiePhoto from '../assets/shared/kansas/kansas-land-prairie.jpg';
---

<BaseLayout
  title="Charity Menefee | Wichita Area Real Estate"
  description="Patient, personal real estate guidance for buyers, sellers, and people exploring land in Wichita and nearby south-central Kansas communities."
  pageClass="page-home"
>
  <Hero />

  <section class="value-section section-space" aria-labelledby="value-title">
    <div class="shell value-grid">
      <div class="value-heading" data-reveal="left">
        <p class="eyebrow">A calmer way to move</p>
        <h2 id="value-title">Clear answers. Local perspective. Room to decide.</h2>
      </div>
      <p class="value-copy" data-reveal="right">
        Real estate can bring a lot of questions at once. Charity keeps the process grounded,
        explains the details plainly, and gives you space to make decisions in your own time.
      </p>
      <div class="value-points reveal-stagger" aria-label="Charity's approach">
        <p data-reveal="up"><span>01</span>Listen before making a plan</p>
        <p data-reveal="up"><span>02</span>Share useful local context</p>
        <p data-reveal="up"><span>03</span>Keep the next step manageable</p>
      </div>
    </div>
  </section>

  <section class="meet-section section-space" aria-labelledby="meet-title">
    <div class="shell meet-grid">
      <div class="meet-image-wrap" data-reveal="left-scale">
        <Picture
          class="meet-image"
          src={charityPhoto}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 48rem) 46vw, 100vw"
          alt="Charity Menefee standing in a warm, welcoming kitchen"
        />
        <p class="image-caption">Charity Menefee · Wichita-area Realtor</p>
      </div>
      <div class="meet-copy" data-reveal="layer-right">
        <p class="eyebrow">Meet Charity</p>
        <h2 id="meet-title">Kansas roots and a comfortably straightforward approach.</h2>
        <p>
          Raised in a small northwest Kansas town, Charity brings that familiar sense of place to
          the work she does across the Wichita area. She is patient, easy-going, and never interested
          in rushing someone through a decision.
        </p>
        <p>Ask the questions you have. Take the time you need. Charity will help you understand the options in front of you.</p>
        <a class="arrow-link" href="/about/">More about Charity <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="services-home section-space" aria-labelledby="services-title">
    <div class="shell">
      <div class="section-heading split-heading">
        <div data-reveal="left">
          <p class="eyebrow">Ways to work together</p>
          <h2 id="services-title">Practical help for the move in front of you.</h2>
        </div>
        <div data-reveal="right">
          <p>One-on-one guidance shaped around your questions, timing, and priorities.</p>
          <a class="arrow-link" href="/services/">View all services <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="communities-home section-space" aria-labelledby="communities-title">
    <div class="shell">
      <div class="section-heading communities-heading">
        <div data-reveal="left">
          <p class="eyebrow">Close to home</p>
          <h2 id="communities-title">Places with their own pace and personality.</h2>
        </div>
        <div data-reveal="right">
          <p>Explore a starting point for learning about Wichita and nearby communities.</p>
          <a class="arrow-link" href="/communities/">Explore all communities <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="community-collage">
        <a class="community-tile community-tile-wichita" href="/communities/wichita/" data-reveal="left-scale">
          <Picture
            src={wichitaPhoto}
            formats={['avif', 'webp']}
            widths={[480, 720, 1024]}
            sizes="(min-width: 48rem) 60vw, 100vw"
            alt="Downtown Wichita beside the Arkansas River in warm evening light"
          />
          <span class="community-tile-copy"><small>City living · established neighborhoods</small>Wichita</span>
        </a>
        <a class="community-tile community-tile-valley" href="/communities/valley-center/" data-reveal="right">
          <Picture
            src={valleyCenterPhoto}
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(min-width: 48rem) 38vw, 100vw"
            alt="The Discover Valley Center welcome sign surrounded by prairie landscaping"
          />
          <span class="community-tile-copy"><small>North of Wichita · a distinct local identity</small>Valley Center</span>
        </a>
        <a class="community-tile community-tile-text community-tile-andover" href="/communities/#community-andover" data-reveal="up">
          <span class="tile-coordinate" aria-hidden="true">NE</span>
          <span class="community-tile-copy"><small>Community page in planning</small>Andover</span>
        </a>
        <a class="community-tile community-tile-text community-tile-derby" href="/communities/#community-derby" data-reveal="up">
          <span class="tile-coordinate" aria-hidden="true">SE</span>
          <span class="community-tile-copy"><small>Community page in planning</small>Derby</span>
        </a>
      </div>
    </div>
  </section>

  <section class="kansas-story" aria-labelledby="kansas-title">
    <div class="kansas-story-image" data-parallax>
      <Picture
        src={prairiePhoto}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 1920]}
        sizes="100vw"
        alt="Open Kansas prairie beneath dramatic clouds in warm evening light"
      />
    </div>
    <div class="shell kansas-story-inner">
      <div class="kansas-story-card" data-reveal="layer-right">
        <p class="eyebrow eyebrow-light">A genuine sense of place</p>
        <h2 id="kansas-title">Kansas is more than a backdrop.</h2>
        <p>
          It is the open horizon, the communities you come to know, and the practical way people
          look out for one another. Charity’s connection to this place shapes the thoughtful,
          down-to-earth way she works.
        </p>
      </div>
    </div>
  </section>

  <section class="journal-preview section-space" aria-labelledby="journal-title">
    <div class="shell journal-grid">
      <div class="journal-intro" data-reveal="left">
        <p class="eyebrow">From the journal</p>
        <h2 id="journal-title">Useful guidance, without the filler.</h2>
        <p>Articles are being prepared for a future launch. They will focus on useful information for real decisions.</p>
        <a class="arrow-link" href="/blog/">Visit the blog <span aria-hidden="true">→</span></a>
      </div>
      <div class="future-topics reveal-stagger" aria-label="Planned article topics">
        <article data-reveal="up"><span>Planned topic</span><h3>Buying with a clearer picture</h3><p>Practical preparation and questions worth asking.</p></article>
        <article data-reveal="up"><span>Planned topic</span><h3>Selling with a thoughtful plan</h3><p>Useful ways to prepare before the listing begins.</p></article>
        <article data-reveal="up"><span>Planned topic</span><h3>Land, acreage, and local life</h3><p>Grounded context for rural-property decisions.</p></article>
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
