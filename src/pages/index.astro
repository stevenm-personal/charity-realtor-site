---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<BaseLayout
  title="Charity Menefee | Wichita Area Real Estate"
  description="Real estate guidance for buyers and sellers in Wichita, Valley Center, and nearby communities."
>
  <Header />
  <ScrollReveal />

  <main>
    <Hero />

    <section class="intro-section shell" aria-labelledby="intro-title">
      <p class="section-number" aria-hidden="true">01</p>
      <div data-reveal="left">
        <p class="eyebrow">Guidance that starts with you</p>
        <h2 id="intro-title">Your plans deserve attention, clarity, and care.</h2>
      </div>
      <p class="section-copy reveal-delay-1" data-reveal="right">
        Every move begins with a different set of questions. Charity helps you sort through
        the details, understand your options, and take the next step at a pace that feels right.
      </p>
    </section>

    <section class="services-section" id="services" aria-labelledby="services-title">
      <div class="shell">
        <div class="section-heading">
          <div data-reveal="left">
            <p class="eyebrow">Ways to work together</p>
            <h2 id="services-title">Support for wherever you are in the process.</h2>
          </div>
          <p class="reveal-delay-1" data-reveal="right">
            Practical, one-on-one guidance designed around your goals—not a one-size-fits-all process.
          </p>
        </div>

        <div class="service-grid reveal-stagger">
          <article data-reveal="up">
            <span class="service-number" aria-hidden="true">01</span>
            <h3>Buying a home</h3>
            <p>Clarify your priorities, explore available homes, and move through each decision with context.</p>
            <a href="#contact">Talk about buying <span aria-hidden="true">→</span></a>
          </article>
          <article data-reveal="up">
            <span class="service-number" aria-hidden="true">02</span>
            <h3>Selling a home</h3>
            <p>Build a thoughtful plan for preparing, presenting, and bringing your home to market.</p>
            <a href="#contact">Talk about selling <span aria-hidden="true">→</span></a>
          </article>
          <article data-reveal="up">
            <span class="service-number" aria-hidden="true">03</span>
            <h3>Planning ahead</h3>
            <p>Explore timing and next steps before you are ready to make a move, without added pressure.</p>
            <a href="#contact">Start planning <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="areas-section shell" id="areas" aria-labelledby="areas-title">
      <div
        class="area-visual"
        role="img"
        aria-label="Placeholder for Wichita and Valley Center community photography"
        data-reveal="left-scale"
      >
        <span>Future community photography</span>
      </div>
      <div class="area-copy reveal-delay-1" data-reveal="right">
        <p class="eyebrow">Close to home</p>
        <h2 id="areas-title">Serving Wichita, Valley Center, and the communities nearby.</h2>
        <p>
          From established neighborhoods to growing areas beyond the city, find support for a move
          that fits your day-to-day life and long-term plans.
        </p>
        <ul class="area-list" aria-label="Primary service areas">
          <li>Wichita</li>
          <li>Valley Center</li>
          <li>Nearby communities</li>
        </ul>
      </div>
    </section>

    <section class="about-section shell" id="about" aria-labelledby="about-title">
      <div
        class="portrait-placeholder"
        role="img"
        aria-label="Placeholder for a future portrait of Charity Menefee"
        data-reveal="scale"
      >
        <span>Future portrait</span>
      </div>
      <div class="about-copy reveal-delay-1" data-reveal="layer-right">
        <p class="eyebrow">Meet Charity</p>
        <h2 id="about-title">Real estate should feel clear and personal.</h2>
        <p>
          Buying or selling a home can bring a lot of decisions at once. Charity's approach keeps
          the focus on your needs, your questions, and the details that matter to your move.
        </p>
        <a class="text-link" href="#contact">Start a conversation <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <CallToAction />
  </main>

  <Footer />
</BaseLayout>
