---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact Charity Menefee | Wichita Area Real Estate"
  description="Start a low-pressure conversation with Charity Menefee about buying, selling, land, or Wichita-area communities."
>
  <PageHero
    eyebrow="Contact"
    title="Bring the questions you have."
    intro="You do not need a finished plan before reaching out. Share what you are considering, and the conversation can begin there."
  />

  <section class="contact-section section-space" aria-labelledby="contact-form-title">
    <div class="shell contact-grid">
      <div class="contact-intro" data-reveal="left">
        <p class="eyebrow">Start a conversation</p>
        <h2 id="contact-form-title">What would you like to talk through?</h2>
        <p>Buying, selling, land, an area you are curious about, or a plan that is still taking shape—all are welcome starting points.</p>
        <div class="development-note">
          <strong>Development note</strong>
          <p>Verified phone, email, and social links are not yet available in the repository. They will be added here after confirmation.</p>
        </div>
      </div>

      <form class="contact-form" aria-describedby="form-status" data-reveal="right">
        <p id="form-status" class="form-status"><strong>Preview only:</strong> this form is not connected to a delivery service yet and cannot send a message.</p>
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" />

        <label for="phone">Phone <span>Optional</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />

        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6"></textarea>

        <button class="button button-primary" type="button" aria-describedby="form-status">Send Message</button>
      </form>
    </div>
  </section>
</BaseLayout>
