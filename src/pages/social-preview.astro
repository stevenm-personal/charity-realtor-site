---
import BaseLayout from '../layouts/BaseLayout.astro';

const cards = [
  { label: 'Default / fallback card', route: 'Used on: home, about, contact, services, buying, selling, land & acreage, communities index, blog index, privacy, disclaimer, 404', src: '/images/static/charity-menefee-social-share.jpg' },
  { label: 'Wichita', route: '/communities/wichita/', src: '/images/static/social/wichita-social-share.jpg' },
  { label: 'Valley Center', route: '/communities/valley-center/', src: '/images/static/social/valley-center-social-share.jpg' },
  { label: 'Andover', route: '/communities/andover/', src: '/images/static/social/andover-social-share.jpg' },
  { label: 'Derby', route: '/communities/derby/', src: '/images/static/social/derby-social-share.jpg' },
  { label: 'Goddard', route: '/communities/goddard/', src: '/images/static/social/goddard-social-share.jpg' },
  { label: 'Maize', route: '/communities/maize/', src: '/images/static/social/maize-social-share.jpg' },
  { label: 'Newton', route: '/communities/newton/', src: '/images/static/social/newton-social-share.jpg' },
  { label: 'Park City', route: '/communities/park-city/', src: '/images/static/social/park-city-social-share.jpg' },
  { label: "Valley Center blog post (Purple Spoon)", route: '/blog/local-guide-valley-center-hometown-favorites/', src: '/images/static/blog/valley-center-hometown-favorites-social.jpg' },
];
---

<BaseLayout
  title="Social-share card preview (temporary, review only)"
  description="Temporary internal review page for social-share card assets. Not part of the public site."
  robots="noindex, nofollow"
  canonical={false}
>
  <section class="shell" style="padding-block: 3rem;">
    <p style="color: var(--color-accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.8rem;">Temporary review page &mdash; not linked in navigation, noindex, safe to delete once reviewed</p>
    <h1 style="margin-block: 0.5rem 2rem;">Social-share card preview</h1>
    <div style="display: grid; gap: 2.5rem;">
      {cards.map((c) => (
        <div>
          <p style="margin-bottom: 0.4rem;"><strong>{c.label}</strong> &mdash; <code>{c.route}</code></p>
          <p style="margin-bottom: 0.5rem; font-size: 0.85rem; color: var(--color-text-muted);">{c.src}</p>
          <img src={c.src} alt={c.label} width="1200" height="630" style="width: 100%; max-width: 60rem; height: auto; display: block; border: 1px solid var(--color-border);" />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
