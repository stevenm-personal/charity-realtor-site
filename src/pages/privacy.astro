---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Privacy Policy | Charity Menefee" description="Privacy policy development page for the Charity Menefee real estate website.">
  <PageHero eyebrow="Site information" title="Privacy policy" intro="The final privacy policy will be added before this website launches publicly." />
  <section class="section-space"><div class="shell legal-placeholder prose" data-reveal="up"><h2>Development placeholder</h2><p>This site is currently noindex and the contact form is not connected to a delivery or storage service. A reviewed privacy policy must replace this placeholder before launch or before any visitor information is collected.</p><a class="arrow-link" href="/contact/">Return to contact <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
