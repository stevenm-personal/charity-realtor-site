---
import { Picture } from 'astro:assets';
import heroImage from '../assets/homepage/homepage-hero.jpg';
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero-media" data-parallax>
    <Picture
      class="home-hero-image"
      src={heroImage}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 3000]}
      sizes="100vw"
      alt="A welcoming home overlooking open Kansas fields at sunset"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="home-hero-overlay" aria-hidden="true"></div>
  <div class="shell home-hero-content">
    <div class="home-hero-copy" data-reveal="hero-copy">
      <p class="eyebrow eyebrow-light">Wichita area · South-central Kansas</p>
      <h1 id="home-hero-title">Make your next move feel simple.</h1>
      <p>
        Whether you’re buying, selling, or relocating, I’ll help you understand your options, set a clear plan, and know what comes next. Expect steady communication and support from the first showing to closing day.
      </p>
      <div class="button-row">
        <a class="button button-light" href="/contact/">Contact Me</a>
        <a class="button button-ghost-light" href="/communities/">Explore Communities</a>
      </div>
    </div>
    <p class="hero-signature" data-reveal="right">Kansas is home. Let’s find the place that works for you.</p>
  </div>
</section>
