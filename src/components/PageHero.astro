---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: 'light' | 'image';
  variant?: 'default' | 'community';
  imagePosition?: string;
  imagePositionMobile?: string;
}

const {
  eyebrow,
  title,
  intro,
  image,
  imageAlt = '',
  tone = image ? 'image' : 'light',
  variant = 'default',
  imagePosition = 'center center',
  imagePositionMobile = imagePosition,
} = Astro.props;

const heroStyle: Record<string, string> | undefined = image
  ? {
      '--page-hero-image-position': imagePosition,
      '--page-hero-image-position-mobile': imagePositionMobile,
    }
  : undefined;
---

<section
  class:list={[
    'page-hero',
    {
      'page-hero-light': tone === 'light',
      'page-hero-has-image': image,
      'page-hero-community': variant === 'community',
    },
  ]}
  style={heroStyle}
>
  {image && (
    <Picture
      class="page-hero-image"
      src={image}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1680]}
      sizes="100vw"
      alt={imageAlt}
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="shell page-hero-content" data-reveal="hero-copy">
    <div class="page-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="page-hero-intro">{intro}</p>
    </div>
  </div>
</section>
