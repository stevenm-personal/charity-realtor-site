<script is:inline>
  (() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (reducedMotion.matches || !('IntersectionObserver' in window)) return;

    document.documentElement.classList.add('reveal-enabled');

    const initializeReveals = () => {
      const elements = document.querySelectorAll('[data-reveal]');
      const parallaxElements = window.matchMedia('(min-width: 48rem)').matches
        ? document.querySelectorAll('[data-parallax]')
        : [];
      const revealCallback = (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add('is-revealed');
          obs.unobserve(entry.target);
        });
      };

      // Standard reveal: unchanged everywhere on the site. Elements only
      // start animating in once they're already well into the viewport.
      const observer = new IntersectionObserver(revealCallback, {
        threshold: 0.12,
        rootMargin: '0px 0px -8% 0px',
      });

      // Blog article body content reveals early instead: a long-form
      // article with content gated behind a "scroll first, then it
      // appears" observer can make a reader think the page ended right as
      // they hit a still-hidden section. Extending the root 200px past the
      // viewport's bottom edge (plus a near-zero threshold) means the next
      // section is already animating in before it's actually on screen.
      const earlyObserver = new IntersectionObserver(revealCallback, {
        threshold: 0,
        rootMargin: '0px 0px 200px 0px',
      });

      elements.forEach((element) => {
        const target = element.closest('.blog-post-body') ? earlyObserver : observer;
        target.observe(element);
      });

      if (parallaxElements.length === 0) return;

      const activeParallaxElements = new Set();
      let frameRequested = false;

      const updateParallax = () => {
        activeParallaxElements.forEach((element) => {
          const frame = element.parentElement;
          if (!frame) return;

          const bounds = frame.getBoundingClientRect();
          const viewportCenter = window.innerHeight / 2;
          const elementCenter = bounds.top + bounds.height / 2;
          const progress = (elementCenter - viewportCenter) / window.innerHeight;
          const offset = Math.max(-32, Math.min(32, progress * -52));

          element.style.setProperty('--parallax-y', `${offset}px`);
        });

        frameRequested = false;
      };

      const requestParallaxUpdate = () => {
        if (frameRequested) return;
        frameRequested = true;
        window.requestAnimationFrame(updateParallax);
      };

      const parallaxObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              activeParallaxElements.add(entry.target);
            } else {
              activeParallaxElements.delete(entry.target);
            }
          });

          requestParallaxUpdate();
        },
        { rootMargin: '20% 0px' },
      );

      parallaxElements.forEach((element) => parallaxObserver.observe(element));
      window.addEventListener('scroll', requestParallaxUpdate, { passive: true });
      window.addEventListener('resize', requestParallaxUpdate, { passive: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeReveals, { once: true });
    } else {
      initializeReveals();
    }
  })();
</script>
