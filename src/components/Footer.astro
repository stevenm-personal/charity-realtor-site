---
import { Image } from 'astro:assets';
import curtisCrewLogo from '../assets/branding/curtis-crew-logo.png';
import realtorLogo from '../assets/branding/realtor-logo.jpg';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-intro">
      <a href="/" class="footer-identity" aria-label="Charity Menefee home">
        <span class="footer-name">Charity Menefee</span>
        <span class="footer-role">REALTOR® · Bricktown ICT Realty</span>
      </a>

      <!-- Add verified telephone and email links here when they are confirmed. -->

      <div class="affiliation-logos" aria-label="Professional affiliations">
        <Image src={realtorLogo} alt="REALTOR® logo" width={42} height={42} />
        <Image src={curtisCrewLogo} alt="Curtis Crew Real Estate logo" width={42} height={42} />
      </div>
    </div>

    <div class="footer-nav-groups">
      <nav class="footer-nav" aria-label="Services navigation">
        <h2>Services</h2>
        <a href="/services/buying/">Buying</a>
        <a href="/services/selling/">Selling</a>
        <a href="/services/land-acreage/">Land &amp; Acreage</a>
        <a href="/services/">All services</a>
      </nav>

      <nav class="footer-nav" aria-label="Community navigation">
        <h2>Communities</h2>
        <a href="/communities/wichita/">Wichita</a>
        <a href="/communities/valley-center/">Valley Center</a>
        <a href="/communities/">Explore all communities</a>
      </nav>

      <nav class="footer-nav" aria-label="Site navigation">
        <h2>More</h2>
        <a href="/about/">About Charity</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
        <a href="/disclaimer/">Disclaimer</a>
      </nav>
    </div>
  </div>

  <div class="shell footer-legal">
    <p>&copy; {year} Charity Menefee. All rights reserved.</p>
    <p>Equal Housing Opportunity.</p>
  </div>
</footer>
