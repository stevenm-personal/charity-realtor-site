---
interface Props {
  label: string;
  variant?: 'standard' | 'wide' | 'portrait';
}

const { label, variant = 'standard' } = Astro.props;
---

<div class:list={['blog-photo-placeholder', `blog-photo-placeholder-${variant}`]} aria-hidden="true">
  <span>Photo coming soon</span>
  <strong>{label}</strong>
</div>
