---
interface Props {
  eyebrow?: string;
  title?: string;
  copy?: string;
  buttonLabel?: string;
}

const {
  eyebrow = "When you're ready",
  title = 'Thinking about your next move?',
  copy = 'Bring your questions, even if your plans are still taking shape. I’ll help you sort through the possibilities without adding pressure.',
  buttonLabel = 'Start a Conversation',
} = Astro.props;
---

<section class="closing-cta" aria-labelledby="closing-title">
  <div class="shell closing-cta-inner">
    <div data-reveal="left">
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h2 id="closing-title">{title}</h2>
    </div>
    <div class="closing-cta-copy" data-reveal="right">
      <p>{copy}</p>
      <a class="button button-light" href="/contact/">{buttonLabel} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
