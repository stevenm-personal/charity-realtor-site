---
const services = [
  {
    title: 'Buying',
    description: "Narrow down what you're looking for, weigh the pros and cons of each home, and move forward when you're ready.",
    href: '/services/buying/',
  },
  {
    title: 'Selling',
    description: 'Build a practical plan for preparing, presenting, and bringing your home to market with clear next steps.',
    href: '/services/selling/',
  },
  {
    title: 'Land & Acreage',
    description: 'Think through rural-property possibilities and the questions that come with land and acreage.',
    href: '/services/land-acreage/',
  },
];
---

<div class="service-card-grid reveal-stagger">
  {services.map((service) => (
    <article class="service-card" data-reveal="up">
      <div>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
      </div>
      <a class="arrow-link" href={service.href}>Explore {service.title} <span aria-hidden="true">→</span></a>
    </article>
  ))}
</div>
